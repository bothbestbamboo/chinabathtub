---
import { getCollection } from "astro:content";
import { formatDate } from "@js/utils";

const allPosts = await getCollection("blog");
const recentPosts = allPosts
	.sort((a, b) => {
		const dateA = a.data.date ? new Date(a.data.date).valueOf() : 0;
		const dateB = b.data.date ? new Date(b.data.date).valueOf() : 0;
		return dateB - dateA;
	})
	.slice(0, 3);
---

<section id="recent-blog">
	<div class="container">
		<div class="section-header">
			<div class="header-left">
				<h2>Insights From the Forefront of Bath Innovation</h2>
			</div>

			<div class="header-right">
				<div class="meta-row">
					<span class="sub-title">INDUSTRY LEADERSHIP</span>
					<a href="/news/" class="view-all-link">View insights ➔</a>
				</div>

				<p>
					Explore our expert analysis on advanced manufacturing techniques, material innovations, and modern design trends that are shaping the future of premium bathtubs and shower enclosures.
				</p>
			</div>
		</div>

		<hr class="section-divider" />

		<div class="blog-grid">
			{
				recentPosts.map((post) => {
					const formattedDate = post.data.date ? formatDate(post.data.date) : "";
					const imageSrc = post.data.image
						? typeof post.data.image === "object"
							? post.data.image.src
							: post.data.image
						: "/assets/images/default-blog.jpg";

					return (
						<article class="blog-card">
							<div class="image-wrapper">
								<a href={`/news/${post.id}/`}>
									<img
										src={imageSrc}
										alt={post.data.imageAlt || post.data.title}
										loading="lazy"
										decoding="async"
									/>
								</a>
							</div>

							<div class="card-meta">
								<span class="post-date">{formattedDate}</span>
							</div>

							<h3 class="card-title">
								<a href={`/news/${post.id}/`}>{post.data.title}</a>
							</h3>

							<p class="card-description">
								{post.data.description || (post.body ? post.body.slice(0, 100) + "..." : "")}
							</p>

							<a href={`/news/${post.id}/`} class="read-more-btn">
								Read more ↗
							</a>
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<style lang="less">
	#recent-blog {
		padding: var(--sectionPadding, 80px 0);
		background-color: #ffffff;

		.container {
			width: 100%;
			max-width: (1322/16em);
			margin: 0 auto;
			padding: 0 (16/16rem);
			box-sizing: border-box;
		}
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: (40/16rem);
		flex-wrap: wrap;
	}

	.header-left {
		flex: 1;
		min-width: (320/16rem);

		h2 {
			font-size: ~"min(2.5rem, 6vw)";
			font-weight: 800;
			color: #111111;
			line-height: 1.2;
			margin: 0;
		}
	}

	.header-right {
		max-width: (500/16em);
		flex-grow: 1;
		display: flex;
		flex-direction: column;

		p {
			font-size: (18/16rem);
			line-height: 1.6;
			color: #4a4a4a;
			margin: 0;
		}
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		margin-bottom: (12/16rem);
	}

	.sub-title {
		font-size: (16/16rem);
		font-weight: 700;
		color: #333333;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0;
	}

	.section-divider {
		border: 0;
		height: 1px;
		background-color: #e5e7eb;
		margin: (40/16rem) 0;
	}

	.view-all-link {
		font-size: (16/16rem);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		text-decoration: none;
		padding: (12/16rem) (24/16rem);
		background-color: var(--primary, #004B87);
		color: #ffffff !important;
		border-radius: 4px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		position: relative;
		overflow: hidden;
		z-index: 1;
		transition: color 0.3s ease;
	}

	.view-all-link::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: #111111;
		z-index: -1;
		transform: scaleX(0);
		transform-origin: left;
		border-radius: 4px;
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.view-all-link:hover {
			color: #ffffff !important;
		}
		.view-all-link:hover::before {
			transform: scaleX(1);
		}
	}

	@media (hover: none) or (pointer: coarse) {
		.view-all-link::before {
			display: none !important;
		}
		.view-all-link:active {
			background-color: #111111 !important;
			color: #ffffff !important;
		}
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax((320/16rem), 1fr));
		gap: (30/16rem);
	}

	.blog-card {
		display: flex;
		flex-direction: column;
		background: transparent;

		.image-wrapper {
			width: 100%;
			aspect-ratio: 16 / 9;
			overflow: hidden;
			border-radius: 12px;
			margin-bottom: (16/16rem);

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}
		}

		&:hover .image-wrapper img {
			transform: scale(1.05);
		}
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: (12/16rem);
		margin-bottom: (8/16rem);
		font-size: (14/16rem);
		color: #666666;
	}

	.card-title {
		display: -webkit-box !important;
		-webkit-line-clamp: 1 !important;
		-webkit-box-orient: vertical !important;
		overflow: hidden !important;
		font-size: (20/16rem);
		font-weight: 700;
		margin: (10/16rem) 0;
		line-height: 1.4;

		a {
			display: inline !important;
			color: #111111;
			text-decoration: none;
			transition: color 0.3s ease;
			&:hover {
				color: var(--primary, #004B87);
			}
		}
	}

	.card-description {
		font-size: (16/16rem);
		line-height: 1.5;
		color: #666666;
		margin: 0 0 (16/16rem) 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-more-btn {
		font-size: (14/16rem);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #111111;
		text-decoration: none;
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		padding: (10/16rem) (20/16rem);
		border: 2px solid #111111;
		border-radius: 4px;
		background-color: transparent;
		transition: all 0.3s ease;

		&:hover {
			background-color: #111111;
			color: #ffffff;
		}
	}

	body.dark-mode {
		#recent-blog {
			background-color: transparent;

			.header-left h2,
			.sub-title,
			.header-right p,
			.card-title a,
			.post-date {
				color: #ffffff;
			}

			.card-title a:hover {
				color: var(--secondary, #C5A059);
			}

			.section-divider {
				background-color: rgba(255, 255, 255, 0.1);
			}

			.card-description {
				color: #cbd5e1;
			}

			.read-more-btn {
				color: #ffffff;
				border-color: #ffffff;
				&:hover {
					background-color: #ffffff;
					color: #111111;
				}
			}
		}
	}
</style>