---
import FAQ, { type FAQItem } from "@components/FAQ/FAQ.astro";

const factoryFaqs: FAQItem[] = [
	{
		question: "Are you a direct factory or a trading company? What is your production capacity?",
		answer: "We are a direct, large-scale manufacturer established in 2009, occupying a 50-acre facility in the Xuanzhou Intelligent Sanitary Ware Industrial Park. With an annual capacity of over 100,000 premium bathtubs and 80,000 shower enclosures, we guarantee stable supply chains and highly competitive factory-direct pricing for B2B volume orders.",
	},
	{
		question: "Can you support complex custom designs (OEM/ODM) and new product development?",
		answer: "Yes. We possess strong in-house R&D capabilities, utilizing advanced 3D modeling software such as UG, CATIA, and ALIAS for drawing-less design. Whether you need custom dimensions, unique shapes, or specific hardware configurations, our engineering team can bring your bespoke sanitary ware concepts to life.",
	},
	{
		question: "What international certifications do your products hold?",
		answer: "We strictly adhere to international standards. Our factory is ISO9001 and ISO14000 certified, and our products hold CE, ACS, and GS certifications. We are also honored with the \"China Top Brand\" title and possess multiple utility model patents for our shower and bathtub innovations.",
	},
	{
		question: "Can we visit your factory or schedule a video tour before placing an order?",
		answer: "Absolutely! We warmly welcome global clients to visit our 50-acre facility. If travel is not feasible, we can arrange a comprehensive video tour of our production lines (molding, polishing, assembly, and QC) to demonstrate our manufacturing excellence firsthand.",
	},
];
---

<FAQ
	topper="Frequently Asked Questions"
	title="Answers to Your Questions About Our Factory"
	items={factoryFaqs}
/>