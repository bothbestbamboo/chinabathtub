---
/**
 * * This page is the blog index and displays all articles with pagination
 **/

// Utils
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import "@styles/sidebar.less";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import BlogRecentArticlesWithSidebar from "@layouts/BlogRecentArticlesWithSidebar.astro";
import CTA from "@components/CTA/CTASimple.astro";

// Images
import placeholderImage from "@assets/images/gallery/bannerreview.jpg";
const placeholderOptimizedImage = await getImage({ src: placeholderImage, format: "webp" });

// 1. 定义动态路由生成函数
export async function getStaticPaths({ paginate }) {
	const posts = await getCollection("blog");
	posts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

	return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;

// 2. 动态 SEO 标题 & 描述
const pageNum = page.currentPage;
const totalPages = page.lastPage;
const PAGE_SIZE = 10;

const pageTitle =
	pageNum > 1
		? `Bathtub Insights & Trends - Page ${pageNum} of ${totalPages} | XC Bath`
		: "Bathtub Insights & Trends | XC Bath Blog";

const pageDescription =
	pageNum > 1
		? `Browse page ${pageNum} of XC Bath industry insights: technical guides, installation tips, and product updates for bathtubs, sanitary ware, and bathroom solutions.`
		: "Technical insights on bathtubs, manufacturing processes, and industry trends from XC Bath — your reliable bathtub factory. Installation guides, material science, and factory updates.";

// 3. ItemList 结构化数据（修复 post.slug -> post.id）
const siteUrl = "https://www.chinabathtub.com";
const itemListSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: pageNum > 1 ? `Bathtub Insights & Trends - Page ${pageNum}` : "Bathtub Insights & Trends",
	numberOfItems: page.data.length,
	itemListElement: page.data.map((post: any, index: number) => ({
		"@type": "ListItem",
		position: (pageNum - 1) * PAGE_SIZE + index + 1,
		url: `${siteUrl}/news/${post.id}/`,
		name: post.data.title,
	})),
};
---

<BaseLayout title={pageTitle} description={pageDescription} heroImage={placeholderOptimizedImage}>
	<script slot="schema" is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

	<Banner
		title="Bathtub Insights & Trends"
		subtitle="Deep dives into performance standards, material science, and technical updates straight from our factory."
		image={placeholderOptimizedImage}
	/>

	<BlogRecentArticlesWithSidebar posts={page.data} />

	{
		totalPages > 1 && (
			<nav class="pagination-container" aria-label="Blog pagination">
				<div class="pagination">
					{page.url.prev ? (
						<a href={page.url.prev} class="pagination-btn">
							&laquo; Previous
						</a>
					) : (
						<span class="pagination-btn disabled">&laquo; Previous</span>
					)}

					<div class="pagination-numbers">
						{Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
							const href = num === 1 ? "/news/" : `/news/${num}/`;
							const isCurrent = page.currentPage === num;
							return (
								<a
									href={href}
									class={`pagination-number ${isCurrent ? "active" : ""}`}
									aria-current={isCurrent ? "page" : undefined}
								>
									{num}
								</a>
							);
						})}
					</div>

					{page.url.next ? (
						<a href={page.url.next} class="pagination-btn">
							Next &raquo;
						</a>
					) : (
						<span class="pagination-btn disabled">Next &raquo;</span>
					)}
				</div>
			</nav>
		)
	}

	<CTA />
</BaseLayout>

<style lang="less">
	.pagination-container {
		display: flex;
		justify-content: center;
		margin: 3rem 0;
	}

	.pagination {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.pagination-numbers {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.pagination-btn,
	.pagination-number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 0.85rem;
		border: 1px solid #e2e8f0;
		border-radius: 6px;
		color: #334155;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: all 0.2s ease;
		background-color: #fff;
	}

	.pagination-btn:hover:not(.disabled),
	.pagination-number:hover:not(.active) {
		border-color: var(--primary, #004B87);
		color: var(--primary, #004B87);
		background-color: #f0f5fa;
	}

	.pagination-number.active {
		background-color: var(--primary, #004B87);
		color: #ffffff;
		border-color: var(--primary, #004B87);
		font-weight: 600;
	}

	.pagination-btn.disabled {
		color: #cbd5e1;
		border-color: #f1f5f9;
		cursor: not-allowed;
		background-color: #f8fafc;
	}

	body.dark-mode {
		.pagination-btn,
		.pagination-number {
			background-color: #1e293b;
			border-color: #334155;
			color: #cbd5e1;

			&:hover:not(.disabled):not(.active) {
				background-color: #0f172a;
				color: #ffffff;
				border-color: #475569;
			}
		}

		.pagination-number.active {
			background-color: var(--primary, #004B87);
			color: #ffffff;
			border-color: var(--primary, #004B87);
		}

		.pagination-btn.disabled {
			background-color: #0f172a;
			color: #475569;
			border-color: #1e293b;
		}
	}
</style>